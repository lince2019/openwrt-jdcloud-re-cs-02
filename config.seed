CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_qualcommax_ipq60xx_DEVICE_jdcloud_re-ss-01=y

# ---- LuCI 基础 + 中文 ----
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-compat=y

# ---- OpenClash（源码随固件编译）----
CONFIG_PACKAGE_luci-app-openclash=y

# ---- OpenClash 依赖（Firewall4/nftables 路线）----
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ruby=y
CONFIG_PACKAGE_ruby-yaml=y
# !! 关键：25.12 分支的 ruby 在 aarch64 上 YJIT 默认为 y
# YJIT 会通过 PKG_BUILD_DEPENDS:ruby/host RUBY_ENABLE_YJIT:rust/host 去完整编译
# Rust 1.96.0 工具链（含 LLVM），在 4 核 runner 上要 2~4 小时，直接把 345 分钟预算烧光。
# master 分支因为有 "depends on BROKEN" 屏蔽，所以不会踩到；25.12 没有该屏蔽。
# OpenClash 只需要 ruby 解释器跑 yaml 解析，完全不需要 JIT。
# CONFIG_RUBY_ENABLE_YJIT is not set
# CONFIG_RUBY_ENABLE_ZJIT is not set
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_dnsmasq-full=y
# CONFIG_PACKAGE_dnsmasq is not set

# ---- 运维工具 ----
CONFIG_PACKAGE_htop=y

# ---- 不使用 WiFi（无线由独立 AP 承担）----
# WiFi 驱动不编译进固件，省内存、缩小内核、消除校准数据不匹配风险
# CONFIG_PACKAGE_kmod-ath11k-ahb is not set
# CONFIG_PACKAGE_ath11k-firmware-ipq6018 is not set
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set

# ---- 刷机用：生成 initramfs 镜像（U-Boot 过渡启动验证）----
CONFIG_TARGET_ROOTFS_INITRAMFS=y
